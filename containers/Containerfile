FROM docker.io/oven/bun:1.4.3-alpine AS dev

WORKDIR /app/builder
COPY package.json .
COPY bun.lock .
COPY bunfig.toml .
RUN bun install --frozen-lockfile

COPY src ./src
COPY public ./public

COPY angular.json .
COPY ngsw-config.json .
COPY tsconfig.json .
COPY tsconfig.app.json .
COPY tsconfig.spec.json .
COPY .postcssrc.json .
COPY scripts ./scripts

FROM dev AS builder

ARG COMMIT_HASH=unknown
RUN bun run build

FROM docker.io/library/nginx:alpine-slim AS prod

COPY containers/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/builder/dist/watch-list/browser /usr/share/nginx/html

EXPOSE 80
